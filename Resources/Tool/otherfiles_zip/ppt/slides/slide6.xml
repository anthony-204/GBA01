{ACB028F6-B86F-8387-6DE5-1FC824F32CE9}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="7651358" y="1643509"/><a:ext cx="4254892" cy="3693319"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US"/><a:t>There were limited options for slow-blow fuses, and here is an example of a fuse that partially satisfies the requirements.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:endParaRPr lang="en-US"/></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US"/><a:t>Let us consider the 500A fuse; here is what it can handle.</a:t></a:r><a:endParaRPr lang="en-AU"/></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-AU"/><a:t>Short circuit current : 256MA for 8 ms.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-AU"/><a:t>Inrush current: 2000A for ~0.8 s.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-AU"/><a:t>Cranking current: 1000A between 1 to 15 seconds</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-AU"/><a:t>Continuous current: 359A during cold ambient conditions.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:endParaRPr lang="en-AU"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="45987240"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>