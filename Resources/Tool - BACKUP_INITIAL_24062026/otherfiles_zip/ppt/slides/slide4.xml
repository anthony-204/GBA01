238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{2399FA7C-8575-0189-9F0E-D30FEE7A112A}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="7275577" y="1124712"/><a:ext cx="4116380" cy="3785652"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1600" dirty="0"/><a:t>This graph shows a 50-MT starter motor, commonly used in heavy machinery that operates on a 24V electrical system.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1600" dirty="0"/><a:t> In such systems, 16V is the minimum voltage threshold; falling below this level can cause critical electrical components to fail or the machinery does not turn ON.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1600" dirty="0"/><a:t> This failure occurs because these components rely on a minimum voltage to maintain stable performance in onboard electronics, control systems, and other low-voltage subsystems. </a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750" algn="just"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1600" dirty="0"/><a:t>Hence, the cranking amps for 16V were obtained from the graph and set as one of the electrical boundary conditions.</a:t></a:r><a:endParaRPr lang="en-AU" sz="1600" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="83108825"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>